# ╔══════════════════════════════════════════════════════════════════╗
# ║         AETHERIA — Environment Variables Reference              ║
# ║  Copy this file to .env and fill in your values                 ║
# ║  DO NOT COMMIT .env TO GIT (it is in .gitignore)               ║
# ╚══════════════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════
# DJANGO CORE
# ═══════════════════════════════════════════════════════════

SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ═══════════════════════════════════════════════════════════
# DATABASE — Supabase PostgreSQL (PRIMARY)
# ═══════════════════════════════════════════════════════════
# Get this from: Supabase Dashboard → Settings → Database → Connection string → URI
# Use port 5432 for direct connection, port 6543 for PgBouncer (pooled)

SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ─── Legacy fallback (Neon / Render) ───────────────────────
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/aetheria?sslmode=require

# ─── Individual vars (used only if SUPABASE_DB_URL is not set) ─
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432

# ═══════════════════════════════════════════════════════════
# SUPABASE — Auth, Storage & Realtime
# ═══════════════════════════════════════════════════════════
# Get from: Supabase Dashboard → Settings → API

# Project URL (e.g. https://abcdefghij.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key — KEEP SECRET, server-side only, never expose to browser
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Anon/Public key — SAFE for browser (used in JS client)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# JWT Secret — from Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# Storage bucket names (created manually in Supabase Storage dashboard)
SUPABASE_BUCKET=media
SUPABASE_BUCKET_AVATARS=avatars
SUPABASE_BUCKET_POSTS=posts
SUPABASE_BUCKET_STORIES=stories
SUPABASE_BUCKET_MESSAGES=messages

# ═══════════════════════════════════════════════════════════
# REDIS — Caching & Django Channels layer
# ═══════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════════
# FIREBASE — Push Notifications (kept alongside Supabase)
# ═══════════════════════════════════════════════════════════

# Option A: Paste the entire service account JSON (preferred for cloud deployment)
FIREBASE_CREDENTIALS_JSON={}

# Option B: Place firebase-service-account.json in socialmedia/ and leave above blank

# Client-side Firebase config (for PWA push notifications)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# ═══════════════════════════════════════════════════════════
# CLOUDINARY — Legacy media storage (migrate → Supabase Storage)
# ═══════════════════════════════════════════════════════════
# NOTE: Supabase Storage takes priority when SUPABASE_URL + SUPABASE_KEY are set.
# Remove CLOUDINARY_URL after running: python scripts/migrate_cloudinary_to_supabase.py
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ═══════════════════════════════════════════════════════════
# EMAIL — Transactional email
# ═══════════════════════════════════════════════════════════
# Supabase Auth sends its own emails (confirmation, password reset).
# Django also sends OTP verification via SMTP below.

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# ═══════════════════════════════════════════════════════════
# SECURITY
# ═══════════════════════════════════════════════════════════

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Supabase WebSocket origins (add your Supabase project URL)
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ═══════════════════════════════════════════════════════════
# DEPLOYMENT
# ═══════════════════════════════════════════════════════════

VERCEL=0
ENVIRONMENT=development

# ═══════════════════════════════════════════════════════════
# SETUP NOTES
# ═══════════════════════════════════════════════════════════
#
# 1. Create a Supabase project at https://supabase.com
#
# 2. In Supabase Dashboard → Storage, create these buckets:
#    - avatars   (public)
#    - posts     (public)
#    - stories   (public)
#    - messages  (private — signed URLs)
#    - media     (default fallback, public)
#
# 3. In Supabase Dashboard → Authentication → Providers:
#    - Enable Email provider
#    - Configure SMTP or use Supabase built-in email
#
# 4. In Supabase Dashboard → Table Editor → Realtime:
#    - Enable Realtime on: users_notification, users_message
#
# 5. Run Django migrations:
#    python manage.py migrate
#
# 6. Migrate existing data to Supabase:
#    python manage.py migrate_to_supabase --dry-run --verbose
#    python manage.py migrate_to_supabase
#
# 7. Migrate Cloudinary media to Supabase Storage:
#    python scripts/migrate_cloudinary_to_supabase.py --dry-run
#    python scripts/migrate_cloudinary_to_supabase.py
#
# 8. Start the Realtime bridge (separate terminal):
#    python manage.py run_realtime_bridge
#
# For Redis local setup:
#    docker run -d -p 6379:6379 redis:latest
#
# For Gmail: use an app-specific password (not your login password):
#    https://support.google.com/accounts/answer/185833
