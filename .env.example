# AETHERIA LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env TO GIT

# ═══════════════════════════════════════════════════════════
# DJANGO CONFIGURATION
# ═══════════════════════════════════════════════════════════

DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ═══════════════════════════════════════════════════════════
# DATABASE CONFIGURATION (Choose One)
# ═══════════════════════════════════════════════════════════

# Option 1: PostgreSQL (RECOMMENDED)
POSTGRES_DB=aetheria
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Option 2: Production PostgreSQL URL (for Render, Vercel, etc)
# DATABASE_URL=postgresql://user:password@host:5432/aetheria

# ═══════════════════════════════════════════════════════════
# REDIS CONFIGURATION
# ═══════════════════════════════════════════════════════════

REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════════
# FIREBASE CONFIGURATION
# ═══════════════════════════════════════════════════════════

# Firebase credentials (paste entire JSON from firebase-service-account.json)
# Or leave this empty if using local firebase-service-account.json file
FIREBASE_CREDENTIALS_JSON={}

# ═══════════════════════════════════════════════════════════
# CLOUDINARY CONFIGURATION (for media uploads)
# ═══════════════════════════════════════════════════════════

CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ═══════════════════════════════════════════════════════════
# EMAIL CONFIGURATION
# ═══════════════════════════════════════════════════════════

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# ═══════════════════════════════════════════════════════════
# OPTIONAL: ERROR TRACKING (Sentry)
# ═══════════════════════════════════════════════════════════

SENTRY_DSN=

# ═══════════════════════════════════════════════════════════
# OPTIONAL: ENVIRONMENT IDENTIFIER
# ═══════════════════════════════════════════════════════════

ENVIRONMENT=development

# ═══════════════════════════════════════════════════════════
# DEPLOYMENT PLATFORMS
# ═══════════════════════════════════════════════════════════

# Set this if running on Vercel
VERCEL=0

# ═══════════════════════════════════════════════════════════
# NOTES
# ═══════════════════════════════════════════════════════════

# 1. For PostgreSQL: Install with: python -m pip install psycopg2-binary
#
# 2. For Redis: Install locally or use docker:
#    docker run -d -p 6379:6379 redis:latest
#
# 3. For Firebase: Download JSON from Firebase Console
#    Project Settings > Service Accounts > Generate New Private Key
#
# 4. For Gmail: Use app-specific password (not your regular password)
#    https://support.google.com/accounts/answer/185833
#
# 5. For Cloudinary: Sign up at https://cloudinary.com
